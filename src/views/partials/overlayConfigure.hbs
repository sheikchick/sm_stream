<div id="left-wrapper">
	<span class="label" id="top-label">Currently displayed on stream</span>
	<div id="header">
		<div id="p1-info-actual" class="info actual">
			<div id="p1-text-actual" class="name-container actual">
				<input type="text" id="p1-name-actual" class="name actual left" value="{{team1.players.[0].name}}"
					tabindex="-1" placeholder="Player 1 name" readonly="true">
				<input type="text" id="p1d-name-actual" class="name actual left doubles" tabindex="-1"
					value="{{team1.players.[1].name}}" placeholder="Player 2 name" readonly="true">
			</div>
			<div class="column stock">
				<img id="p1-character-actual" class="stock-icon actual" src="stock">
				<img id="p1d-character-actual" class="stock-icon actual doubles" src="stock">
			</div>
			<input id="p1-score-actual" class="score actual" min="0" max="99" value="{{team1.score}}" readonly="true"
				tabindex="-1">
		</div>

		<div id="p2-info-actual" class="info actual">
			<input id="p2-score-actual" class="score actual" min="0" max="99" value="{{team2.score}}" readonly="true"
				tabindex="-1">
			<div class="column stock">
				<img id="p2-character-actual" class="stock-icon actual" src="stock">
				<img id="p2d-character-actual" class="stock-icon actual doubles" src="stock">
			</div>
			<div id="p2-text-actual" class="name-container actual">
				<input type="text" id="p2-name-actual" class="name actual right" value="{{team2.players.[0].name}}"
					tabindex="-1" placeholder="Player 1 name" readonly="true">
				<input type="text" id="p2d-name-actual" class="name actual right doubles" tabindex="-1"
					value="{{team2.players.[1].name}}" placeholder="Player 2 name" readonly="true">
			</div>
		</div>
		<div id="data-actual" class="data actual column">
			<input type="text" id="round-actual" class="data-text actual" value="{{round}}" placeholder="Round"
				tabindex="-1" readonly="true">
			<input id="best-of-actual" class="data-text actual" best-of="{{bestOf}}" value="Bo{{bestOf}}" tabindex="-1"
				readonly="true">
		</div>
	</div>
	<div id="p1-info-change" class="info change left">
		<input type="text" id="p1-entrant" class="startgg display id left" value="{{team1.startggEntrant}}"
			placeholder="start.gg Entrant">
		<button type="button" id="team1-swap" class="swap left" onclick="swapTeam(1)"><i
				class="fa-solid fa-arrows-up-down"></i></button>
		<div class="player info wrapper column">
			<div class="player header row">
				<input type="text" id="p1-prefix" class="prefix change left" value="{{team1.players.[0].prefix}}"
					placeholder="Player 1 prefix">
			</div>
			<div class="player info row">
				<button type="button" id="t1p1-database" class="database left" title="Update player in database"
					onclick="submitNewPlayer('1')"><i class="fa-solid fa-database"></i></button>
				<input type="text" id="p1-slug" class="slug change left" value="{{team1.players.[0].slug}}"
					placeholder="start.gg slug">
				<input type="text" id="p1-pronouns" class="pronouns change left" value="{{team1.players.[0].pronouns}}"
					placeholder="Pronouns">
				<select class="flag change left" id="p1-flag"></select>
				<div class="name-container change">
					<input type="text" id="p1-name" class="name change left" value="{{team1.players.[0].name}}"
						placeholder="Player 1 name" onKeyUp="showResults(this.id, this.value)">
					<div id="p1-autofill" class="autofill"></div>
				</div>
			</div>
			<div class="player header row doubles">
				<input type="text" id="p1d-prefix" class="prefix change left doubles"
					value="{{team1.players.[1].prefix}}" placeholder="Player 2 prefix">
			</div>
			<div class="player info row doubles">
				<button type="button" id="t1p2-database" class="database left doubles" title="Update player in database"
					onclick="submitNewPlayer('1d')"><i class="fa-solid fa-database"></i></button>
				<input type="text" id="p1d-slug" class="slug change left doubles" value="{{team1.players.[1].slug}}"
					placeholder="start.gg slug">
				<input type="text" id="p1d-pronouns" class="pronouns change left doubles"
					value="{{team1.players.[1].pronouns}}" placeholder="Pronouns">
				<select class="flag change left doubles" id="p1d-flag"></select>
				<div class="name-container change">
					<input type="text" id="p1d-name" class="name change left doubles" value="{{team1.players.[1].name}}"
						placeholder="Player 2 name" onKeyUp="showResults(this.id, this.value)">
					<div id="p1d-autofill" class="autofill doubles"></div>
				</div>
			</div>
		</div>
		<img id="p1-character-change" class="csp change" src="csp" onclick="swapCharacter(this.id, 1)">
		<img id="p1d-character-change" class="csp change doubles" src="csp" onclick="swapCharacter(this.id, 1)">
		<div class="column">
			<input type="number" id="p1-score-change" class="score change left" pattern="[0-9]" value="{{team1.score}}">
		</div>
		<div class="column changer">
			<button class="score-changer" onclick="changeScore(1,1)">+</button>
			<button class="score-changer" onclick="changeScore(-1,1)">-</button>
		</div>
		<div class="team-colour-wrapper column">
			<button id="p1-red" class="team-colour red-colour" onclick="changeTeamColour(1, 'red')">R</button>
			<button id="p1-green" class="team-colour green-colour" onclick="changeTeamColour(1, 'green')">G</button>
			<button id="p1-blue" class="team-colour blue-colour" onclick="changeTeamColour(1, 'blue')">B</button>
		</div>
	</div>

	<div id="middle-row" class="row">
		<button type="button" id="p1-entrant-button" class="startgg entrant" onclick="toggleStartggEntrant()"
			title="Toggle display of start.gg IDs for current set"><img class="small-svg-icon"
				src="static/img/startgg.svg" /></button>
		<input type="text" id="set-id" class="startgg display setid" value="{{startggSetId}}"
			placeholder="start.gg Set ID">
		<button id="find-set" class="startgg" onclick="findSetForPlayers()"
			title="Find start.gg set for given players">Find start.gg set</button>
		<div id="swap-group">
			<button type="button" id="swap-all" class="swap-sides" onclick="swapSides(true, true)">
				All <i class="fa-solid fa-arrows-up-down"></i>
			</button>
			<button type="button" id="swap-info" class="swap-sides" onclick="swapSides(true, false)">
				Info <i class="fa-solid fa-arrows-up-down"></i>
			</button>
			<button type="button" id="swap-chars" class="swap-sides" onclick="swapSides(false, true)">
				Chars. <i class="fa-solid fa-arrows-up-down"></i>
			</button>
		</div>
		<button type="button" id="reset-scores" class="" onclick="resetScores()">
			Reset scores <i class="fas fa-undo"></i>
		</button>
	</div>

	<div id="p2-info-change" class="info change right">
		<input type="text" id="p2-entrant" class="startgg display id right" value="{{team2.startggEntrant}}"
			placeholder="P2 start.gg Entrant">
		<button type="button" id="team2-swap" class="swap right
				" onclick="swapTeam(2)"><i class="fa-solid fa-arrows-up-down"></i></button>
		<div class="player info wrapper column">
			<div class="player header row">
				<input type="text" id="p2-prefix" class="prefix change right" value="{{team2.players.[0].prefix}}"
					placeholder="Player 1 prefix">
			</div>
			<div class="player info row">
				<button type="button" id="t2p1-database" class="database right" title="Update player in database"
					onclick="submitNewPlayer('2')"><i class="fa-solid fa-database"></i></button>
				<input type="text" id="p2-slug" class="slug change right" value="{{team2.players.[0].slug}}"
					placeholder="start.gg slug">
				<input type="text" id="p2-pronouns" class="pronouns change right" value="{{team2.players.[0].pronouns}}"
					placeholder="Pronouns">
				<select class="flag change right" id="p2-flag"></select>
				<div class="name-container change">
					<input type="text" id="p2-name" class="name change right" value="{{team2.players.[0].name}}"
						placeholder="Player 1 name" onKeyUp="showResults(this.id, this.value)">
					<div id="p2-autofill" class="autofill"></div>
				</div>
			</div>
			<div class="player header row doubles">
				<input type="text" id="p2d-prefix" class="prefix change right doubles"
					value="{{team2.players.[1].prefix}}" placeholder="Player 2 prefix">
			</div>
			<div class="player info row doubles">
				<button type="button" id="t2p2-database" class="database right doubles"
					title="Update player in database" onclick="submitNewPlayer('2d')"><i
						class="fa-solid fa-database"></i></button>
				<input type="text" id="p2d-slug" class="slug change right doubles" value="{{team2.players.[1].slug}}"
					placeholder="start.gg slug">
				<input type="text" id="p2d-pronouns" class="pronouns change right doubles"
					value="{{team2.players.[1].pronouns}}" placeholder="Pronouns">
				<select class="flag change right doubles" id="p2d-flag"></select>
				<div class="name-container change">
					<input type="text" id="p2d-name" class="name change right doubles"
						value="{{team2.players.[1].name}}" placeholder="Player 2 name"
						onKeyUp="showResults(this.id, this.value)">
					<div id="p2d-autofill" class="autofill doubles"></div>
				</div>
			</div>
		</div>
		<img id="p2-character-change" class="csp change" src="csp" onclick="swapCharacter(this.id, 2)">
		<img id="p2d-character-change" class="csp change doubles" src="csp" onclick="swapCharacter(this.id, 2)">
		<div class="column">
			<input type="number" id="p2-score-change" class="score change right" min="0" max="99"
				value="{{team2.score}}">
		</div>
		<div class="column changer">
			<button class="score-changer" onclick="changeScore(1,2)">+</button>
			<button class="score-changer" onclick="changeScore(-1,2)">-</button>
		</div>
		<div class="team-colour-wrapper column">
			<button id="p2-red" class="team-colour red-colour" onclick="changeTeamColour(2, 'red')">R</button>
			<button id="p2-green" class="team-colour green-colour" onclick="changeTeamColour(2, 'green')">G</button>
			<button id="p2-blue" class="team-colour blue-colour" onclick="changeTeamColour(2, 'blue')">B</button>
		</div>
	</div>
	<div id="seat-wrapper" class="row">
		<button id="seat-reset" onclick="resetSeats()"><i class="fa-solid fa-rotate-left"></i></button>
		<div class="seat p1 left column" id="p1-left-seat" index="{{seatOrdering.[0]}}">
			<span class="name" tabindex="-1">{{team1.players.[0].name}}</span>
			<img class="stock-icon" src="static/img/melee/stock_icons/smash.png">
			<span class="header">
				<i class="fas fa-chair" style="opacity: 100%;"></i>
				<i class="fas fa-chair doubles" style="opacity: 15%;"></i>
				&nbsp;
				<i class="fas fa-chair" style="opacity: 15%;"></i>
				<i class="fas fa-chair doubles" style="opacity: 15%;"></i>
			</span>
		</div>
		<button class="seat-changer side" id="left-seat-changer" onclick="swapSeatTeam(1)"><i
				class="fa-solid fa-left-right"></i></button>
		<div class="seat p1 right column" id="p1-right-seat" index="{{seatOrdering.[1]}}">
			<span class="name" tabindex="-1">{{team1.players.[1].name}}</span>
			<img class="stock-icon" src="static/img/melee/stock_icons/smash.png">
			<span class="header">
				<i class="fas fa-chair" style="opacity: 15%;"></i>
				<i class="fas fa-chair" style="opacity: 100%;"></i>
				&nbsp;
				<i class="fas fa-chair" style="opacity: 15%;"></i>
				<i class="fas fa-chair" style="opacity: 15%;"></i>
			</span>
		</div>
		<button class="seat-changer" onclick="swapSeatSides()">Swap sides<br /><i
				class="fa-solid fa-left-right"></i></button>
		<div class="seat p2 left column" id="p2-left-seat" index="{{seatOrdering.[2]}}">
			<span class="name" tabindex="-1">{{team2.players.[0].name}}</span>
			<img class="stock-icon" src="static/img/melee/stock_icons/smash.png">
			<span class="header">
				<i class="fas fa-chair" style="opacity: 15%;"></i>
				<i class="fas fa-chair doubles" style="opacity: 15%;"></i>
				&nbsp;
				<i class="fas fa-chair" style="opacity: 100%;"></i>
				<i class="fas fa-chair doubles" style="opacity: 15%;"></i>
			</span>
		</div>
		<button class="seat-changer side" id="right-seat-changer" onclick="swapSeatTeam(2)"><i
				class="fa-solid fa-left-right"></i></button>
		<div class="seat p2 right column" id="p2-right-seat" index="{{seatOrdering.[3]}}">
			<span class="name" tabindex="-1">{{team2.players.[1].name}}</span>
			<img class="stock-icon" src="static/img/melee/stock_icons/smash.png">
			<span class="header">
				<i class="fas fa-chair" style="opacity: 15%;"></i>
				<i class="fas fa-chair" style="opacity: 15%;"></i>
				&nbsp;
				<i class="fas fa-chair" style="opacity: 15%;"></i>
				<i class="fas fa-chair" style="opacity: 100%;"></i>
			</span>
		</div>
	</div>

	<div id="data-wrapper" class="row">
		<input type="text" id="tournament-change" value="{{tournament}}" placeholder="Tournament">
		<div class="column">
			<input type="text" id="round-change" value="{{round}}" placeholder="Round">
		</div>
		<select class="best-of" id="best-of-change" onchange="changeBestOf()">
			<option disabled>Regular</option>
			<option value="3">Best of 3</option>
			<option value="5">Best of 5</option>
			<option disabled>Special</option>
			<option class="special" value="7">Best of 7</option>
			<option class="special" value="9">Best of 9</option>
		</select>
		<button type="button" class="toggle-doubles" onclick="toggleDoubles()" value="{{isDoubles}}"
			title="Toggle between Singles/Doubles"></button>
		<button type="button" class="update" onclick="update()">Update <i class="fa fa-sync"></i></button>
	</div>

	<div id="caster-wrapper" class="row">
		<img class="icon" id="caster-icon" src="static/img/microphone.svg" alt="Mic" />
		<div class="caster row">
			<input type="text" id="caster1-name" value="" class="caster caster-name" placeholder="Caster 1 name">
			<input type="text" id="caster1-pronouns" value="" class="caster pronouns" placeholder="Pronouns">
		</div>
		<div class="caster row">
			<input type="text" id="caster2-name" value="" class="caster caster-name" placeholder="Caster 2 name">
			<input type="text" id="caster2-pronouns" value="" class="caster pronouns" placeholder="Pronouns">
		</div>
	</div>
	<div id="obs-wrapper" class="row">
		<img class="icon" id="obs-icon" src="static/img/obs.svg" alt="OBS" />
		<div class="row" id="obs-load">
			<button type="button" id="ffmpeg-clip" onclick="clip()"><img class="clip"
					src="static/img/clip.svg" /></button>
			<div id="scene-box">
				<select id="scenes"></select>
				<div>
					<button id="update-scene" class="scene" onclick="updateScene()">Change Scene</button>
				</div>
			</div>
		</div>
	</div>
</div>